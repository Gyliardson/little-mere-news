# ==========================================
# Little Mere News - Root Infrastructure Example
# ==========================================
# Optional host-side orchestration settings only.
# Do NOT place Supabase service-role credentials in this file for the Hyper-V batch path.
# Publisher secrets are provisioned on the trusted Publisher VM as documented in
# docs/deployment.md (/home/lmnadmin/.config/lmn/publisher.env, mode 600).

# Optional alternate SSH host-key trust store.
# If unset, Infrastructure/Run-LMN-Batch.ps1 uses the current account's ~/.ssh/known_hosts.
# Enroll VM keys only after verifying their fingerprints through a trusted channel.
# LMN_KNOWN_HOSTS_FILE=C:\Users\you\.ssh\lmn_known_hosts

# Required only when using optional Hyper-V VM provisioning.
# The setup has an explicit reviewed HTTPS default for Ubuntu 24.04 LTS. Override the URL
# only when intentionally changing the exact image, and review URL + digest together.
# LMN_UBUNTU_ISO_URL=https://releases.ubuntu.com/24.04/ubuntu-24.04.4-live-server-amd64.iso
# Set this to the 64-character SHA-256 for the exact configured Ubuntu ISO after
# verifying it against the official Ubuntu release manifest through a trusted channel.
# SHA-256 verifies image integrity; it does not independently authenticate the release origin.
# LMN_UBUNTU_ISO_SHA256=<64-character-sha256>

# Optional Hyper-V network-readiness timeout for each VM, in seconds.
# Accepted range: 5-600. Default: 120.
# LMN_VM_READY_TIMEOUT_SECONDS=120

# Portable/non-Hyper-V workers may set queue paths in their own process environments.
# Keep every ownership state distinct; never point Harvester pending and Publisher retry
# or inbound/retry/quarantine at the same file.
#
# Harvester pending (Harvester process):
# LMN_OUTPUT_FILE=/tmp/lmn/harvester.pending.json
#
# Publisher process:
# LMN_INPUT_FILE=/tmp/lmn/publisher.inbound.json
# LMN_RETRY_FILE=/tmp/lmn/publisher.retry.json
# LMN_REJECTED_FILE=/tmp/lmn/publisher.rejected.json
