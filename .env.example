# ==========================================
# Little Mere News - Root Infrastructure Example
# ==========================================
# Rename this file to ".env" and fill in your actual credentials.
# This file provides environment variables for the Infrastructure scripts.

# Supabase Connection
SUPABASE_URL=https://your-project-id.supabase.co
# service_role key (Admin access)
SUPABASE_KEY=your-service-role-key-here

# Harvester -> Publisher file handoff
# LMN_OUTPUT_FILE and LMN_INPUT_FILE should use the same shared queue path.
LMN_OUTPUT_FILE=/home/lmnadmin/news_to_publish.json
LMN_INPUT_FILE=/home/lmnadmin/news_to_publish.json
LMN_REJECTED_FILE=/home/lmnadmin/news_to_publish.rejected.json
