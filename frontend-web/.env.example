# ==========================================
# Little Mere News - Frontend Example Config
# ==========================================
# Rename this file to ".env.local" and fill in your actual credentials.

# Canonical public site URL used for metadata, sitemap, and robots.
# Set this to the deployed HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Supabase Keys (Accessible on the client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Private Server Keys (NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional admin URL obscurity only. This is NOT authentication or authorization.
ADMIN_PHANTOM_PATH=your-secret-path-slug
